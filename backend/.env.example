# 火山方舟（豆包）API Key，必填
ARK_API_KEY=
# 对话默认（Auto）用 DeepSeek V4 Pro；能选哪些模型见 app/models.toml，这里只配 key
DEEPSEEK_API_KEY=
# 别的几家可选：配了 key 的那家，它的模型才出现在选单里（地址默认国内站，见 app/config.py；key 是国际站或专属地址的，设同名的 *_BASE_URL）
# Kimi、Grok、千问（阿里云百炼，DASHSCOPE_BASE_URL 要 compatible-mode 的地址）、小米 MiMo、智谱 GLM、腾讯混元（腾讯云 TokenHub 的 key）、MiniMax
MOONSHOT_API_KEY=
XAI_API_KEY=
DASHSCOPE_API_KEY=
MIMO_API_KEY=
ZHIPUAI_API_KEY=
HUNYUAN_API_KEY=
MINIMAX_API_KEY=

# 以下可选，不填用默认值
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_MODEL=doubao-seed-2-1-pro-260915
# ARK_MODEL_LITE=doubao-seed-2-1-lite-260915
# ARK_IMAGE_MODEL=doubao-seedream-5-0-flash-260915
# LINGDRAFT_BACKGROUND=1
# LINGDRAFT_FAKE=0

# dev 上的 agent-tools 网关（搜索、读网页、天气、生图），产品密钥向网关申请
AGENT_TOOLS_URL=http://agent-tools.dev.seanfield.org   # 本机开发走 http（dev 的 nginx 对 *.dev 域名没配 https）；容器内用 http://agent-tools-gateway:8100
AGENT_TOOLS_API_KEY=
# 工作任务里跑命令（沙箱，经同一个网关；网关要放行 sandbox）。0 关掉，默认开
# LINGDRAFT_SANDBOX=1

# 对话（检查点、长期记忆、运行记录）存 Postgres，必须配，没配服务起不来。本机连 dev 上的库要先开隧道：ssh -N -L 15432:127.0.0.1:5432 dev
# 本机验证用 lingdraft_local 库，部署在 dev 上的用 lingdraft 库（容器里主机名是 postgres:5432），比如
# postgresql://lingdraft:密码@127.0.0.1:15432/lingdraft_local
LINGDRAFT_DATABASE_URL=

# 登录：Sean 的 auth 服务（见 app/identity.py 和 README）。AUTH_CLIENT_ID 不配就没有登录，所有人都是游客。
# 本机开发：AUTH_URL 用公开地址（验签的公钥也从它取），页面从 http://localhost:5173 跳过去登录
AUTH_URL=https://auth.seanfield.org
AUTH_CLIENT_ID=
# 容器内直连 auth 服务取公钥、查吊销标记（本机不配）
# AUTH_INTERNAL_URL=http://auth-service:8100
# AUTH_REDIS_URL=redis://middleware-redis:6379/0
# 签游客令牌的密钥（随便一串长随机字符，比如 openssl rand -hex 32）：部署必配，不配每次启动随机一个，重启后游客的对话找不回
LINGDRAFT_GUEST_SECRET=
# 一个地址一天最多领几个游客身份（默认 5）
# LINGDRAFT_GUEST_PER_IP_DAILY=5
# 额度（见 app/quota.py，1 credit = ¥0.001）：游客每天、登录用户每天和每周、所有游客合计每天。默认就是 Sean 定的数，一般不用改
# LINGDRAFT_CREDITS_GUEST_DAILY=1000
# LINGDRAFT_CREDITS_USER_DAILY=10000
# LINGDRAFT_CREDITS_USER_WEEKLY=50000
# LINGDRAFT_CREDITS_GUESTS_DAILY=50000
