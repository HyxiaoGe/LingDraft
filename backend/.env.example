# 火山方舟（豆包）API Key，必填
ARK_API_KEY=
# 调研场景默认用 DeepSeek V4 Pro（思考 high）；RESEARCH_PROVIDER=ark 可切回豆包
DEEPSEEK_API_KEY=
# RESEARCH_PROVIDER=deepseek
# RESEARCH_THINKING=1
# RESEARCH_EFFORT=high

# 以下可选，不填用默认值
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_MODEL=doubao-seed-2-1-pro-260915
# ARK_MODEL_LITE=doubao-seed-2-1-lite-260915
# ARK_IMAGE_MODEL=doubao-seedream-5-0-flash-260915
# LINGDRAFT_BACKGROUND=1
# LINGDRAFT_FAKE=0

# dev 上的 agent-tools 网关（搜索 / 网页读取），产品密钥向网关申请
AGENT_TOOLS_URL=http://agent-tools.dev.seanfield.org   # 本机开发走 http（dev 的 nginx 对 *.dev 域名没配 https）；容器内用 http://agent-tools-gateway:8100
AGENT_TOOLS_API_KEY=
